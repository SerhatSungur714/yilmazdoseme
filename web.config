<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        
        <!-- URL Rewriting Rules -->
        <rewrite>
            <rules>
                <!-- Remove .html extension from URLs -->
                <rule name="Remove HTML extension" stopProcessing="true">
                    <match url="^(.*)\.html$" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="{R:1}.html" />
                </rule>
                
                <!-- Redirect www to non-www -->
                <rule name="Remove www prefix" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTP_HOST}" pattern="^www\.yilmazdoseme\.com$" />
                    </conditions>
                    <action type="Redirect" url="https://yilmazdoseme.com/{R:1}" redirectType="Permanent" />
                </rule>
                
                <!-- Force HTTPS -->
                <rule name="Force HTTPS" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^OFF$" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
                </rule>
                
                <!-- Redirect index.html to root -->
                <rule name="Redirect index.html" stopProcessing="true">
                    <match url="^index\.html$" />
                    <action type="Redirect" url="/" redirectType="Permanent" />
                </rule>
                
                <!-- Cache busting for static files -->
                <rule name="Cache busting" stopProcessing="true">
                    <match url="^(.+)\.[0-9]+\.(js|css|png|jpg|jpeg|gif|svg|woff|woff2|ttf)$" />
                    <action type="Rewrite" url="{R:1}.{R:2}" />
                </rule>
            </rules>
        </rewrite>
        
        <!-- HTTP/2 Push aktivasyonu -->
        <httpProtocol>
            <customHeaders>
                <!-- Security Headers -->
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="X-XSS-Protection" value="1; mode=block" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
                
                <!-- SEO Headers -->
                <add name="Content-Language" value="tr-TR" />
            </customHeaders>
        </httpProtocol>
        
        <!-- Compression - Gzip ve Deflate -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />
        
        <dynamicCompression>
            <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" staticCompressionLevel="9" />
            <scheme name="deflate" dll="%Windir%\system32\inetsrv\deflate.dll" staticCompressionLevel="9" />
            
            <mimeTypes>
                <add mimeType="text/plain" enabled="true" />
                <add mimeType="text/html" enabled="true" />
                <add mimeType="text/xml" enabled="true" />
                <add mimeType="text/css" enabled="true" />
                <add mimeType="application/javascript" enabled="true" />
                <add mimeType="application/json" enabled="true" />
                <add mimeType="application/xml" enabled="true" />
                <add mimeType="text/javascript" enabled="true" />
                <add mimeType="application/ld+json" enabled="true" />
                <add mimeType="image/svg+xml" enabled="true" />
                <add mimeType="image/x-icon" enabled="true" />
            </mimeTypes>
        </dynamicCompression>
        
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
            
            <!-- MIME Types for Web Fonts -->
            <mimeMap fileExtension=".woff" mimeType="font/woff" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
            <mimeMap fileExtension=".eot" mimeType="application/vnd.ms-fontobject" />
            <mimeMap fileExtension=".otf" mimeType="font/otf" />
            
            <!-- MIME Types for WebP Images -->
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            
            <!-- MIME Types for Manifest -->
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            
            <!-- MIME Types for SVG -->
            <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
            
            <!-- Cache Control for Different File Types -->
            <!-- HTML - Short cache (1 gün) -->
            <rule>
                <match url="^.*\.html?$" />
                <action type="CustomResponse" statusCode="200" subStatusCode="0" statusReason="Cached" statusDescription="OK" />
            </rule>
            
            <!-- CSS ve JS - Long cache (1 yıl) - Cache busting için -->
            <rule>
                <match url="^.*\.(css|js)$" />
                <action type="CustomResponse" statusCode="200" subStatusCode="0" statusReason="Cached" statusDescription="OK" />
            </rule>
            
            <!-- Images - Long cache (30 gün) -->
            <rule>
                <match url="^.*\.(jpg|jpeg|png|gif|webp|svg|ico)$" />
                <action type="CustomResponse" statusCode="200" subStatusCode="0" statusReason="Cached" statusDescription="OK" />
            </rule>
        </staticContent>
        
        <!-- Custom Error Pages -->
        <httpErrors>
            <error statusCode="404" prefixLanguageFilePath="" path="index.html" responseMode="ExecuteURL" />
            <error statusCode="500" prefixLanguageFilePath="" path="index.html" responseMode="ExecuteURL" />
        </httpErrors>
        
        <!-- Request Filtering -->
        <security>
            <requestFiltering>
                <!-- Block potentially dangerous file types -->
                <fileExtensions>
                    <add fileExtension=".php" allowed="false" />
                    <add fileExtension=".asp" allowed="false" />
                    <add fileExtension=".aspx" allowed="false" />
                    <add fileExtension=".exe" allowed="false" />
                    <add fileExtension=".bat" allowed="false" />
                </fileExtensions>
                
                <!-- Maximum file upload size: 100MB -->
                <requestLimits maxAllowedContentLength="104857600" />
            </requestFiltering>
        </security>
        
        <!-- IIS Request Monitor Configuration -->
        <tracing>
            <traceFailedRequests>
                <add path="*.aspx">
                    <traceAreas>
                        <add provider="ASP" verbosity="Verbose" />
                    </traceAreas>
                    <failureDefinitions statusCodes="404,500" />
                </add>
            </traceFailedRequests>
        </tracing>
        
    </system.webServer>
    
    <!-- Application Settings -->
    <appSettings>
        <!-- Site Name -->
        <add key="SiteName" value="Yılmaz Döşeme" />
        <add key="SiteUrl" value="https://yilmazdoseme.com" />
        <add key="AdminEmail" value="info@yilmazdoseme.com" />
    </appSettings>
    
    <!-- Connection Strings (eğer veritabanı kullanılırsa) -->
    <connectionStrings>
        <!-- Ileride veritabanı bağlantısı için hazır -->
    </connectionStrings>
    
</configuration>
